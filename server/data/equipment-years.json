  "eraDefaults": {
    "description": "Default equipment assignments by era for mass equipment assignment",
    "1970-1979": {
      "helmet": ["GearHelmet_RiddellTK"],
      "shoes": ["GearFootwear_shoeLowVintage_nike"],
      "gloves": ["GearHand_None", "GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "linemanGloves": ["GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "notes": "Riddell TK era - linemen heavily taped hands"
    },
    "1980-1989": {
      "helmet": ["GearHelmet_RiddellTK", "GearHelmet_Standard", "GearHelmet_Schutt"],
      "shoes": ["GearFootwear_shoeLowVintage_nike"],
      "gloves": ["GearHand_None", "GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "linemanGloves": ["GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "notes": "Transition: Riddell TK still common early, VSR4 + Schutt Air Advantage arriving late 80s"
    },
    "1990-1999": {
      "helmet": ["GearHelmet_Standard", "GearHelmet_Schutt", "GearHelmet_AirXP"],
      "shoes": ["GearFootwear_shoeLowVintage_nike", "GearFootwear_shoe_Mid_NikeDiamondTURF"],
      "gloves": ["GearHand_None", "GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "linemanGloves": ["GearHand_tapedHandFinger_White", "GearHand_tapedHandNormal_White"],
      "notes": "Riddell VSR4 (Standard) + Schutt Air Advantage / Air XP era - Diamond Turf starts 1993"
    },
    "2000-2007": {
