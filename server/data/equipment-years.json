  "shoulderPads": {
    "description": "Shoulder pad size evolution by era - pads got significantly smaller starting in 2000s",
    "evolution": {
      "1970-1989": {
        "defaultSize": "Large_Pads",
        "notes": "Massive pads were the norm. All positions wore bulky, heavy shoulder pads for maximum protection. Pads extended well past shoulders."
      },
      "1990-1999": {
        "defaultSize": "Large_Pads",
        "notes": "Still large pads dominant. Some skill position players started experimenting with slightly smaller cuts. Linemen kept maximum protection."
      },
      "2000-2009": {
        "defaultSize": "Medium_Pads",
        "skillPositions": "Medium_Pads",
        "linemen": "Large_Pads",
        "notes": "Technology advances allowed lighter materials. Skill players moved to smaller pads for mobility. WRs/CBs led the trend. Linemen kept large pads."
      },
      "2010-2019": {
        "defaultSize": "Small_Pads",
        "skillPositions": "Small_Pads",
        "linemen": "Medium_Pads",
        "notes": "Modern lightweight materials became standard. Skill players use minimal pads barely covering shoulders. Even some linemen downsized."
      },
      "2020-2025": {
        "defaultSize": "Small_Pads",
        "skillPositions": "Small_Pads",
        "linemen": "Medium_Pads",
        "notes": "Current era - minimal pads are the norm. Advanced materials provide protection without bulk. Some skill players wear pads barely visible under jerseys."
      }
    },
    "positionTendencies": {
      "QB": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Small_Pads",
        "notes": "QBs were early adopters of smaller pads for throwing mobility"
      },
      "RB": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Small_Pads",
        "notes": "Running backs reduced size for agility and vision"
      },
      "WR": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Small_Pads",
        "notes": "Receivers led the small pad revolution for route running"
      },
      "TE": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Medium_Pads",
        "notes": "TEs keep slightly larger pads for blocking duties"
      },
      "OL": {
        "pre2000": "Large_Pads",
        "2000s": "Large_Pads",
        "2010s": "Medium_Pads",
        "notes": "Offensive linemen were last to reduce size, still wear larger pads"
      },
      "DL": {
        "pre2000": "Large_Pads",
        "2000s": "Large_Pads",
        "2010s": "Medium_Pads",
        "notes": "Defensive linemen similar to OL, prioritize protection"
      },
      "LB": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Medium_Pads",
        "notes": "Linebackers balance protection and mobility"
      },
      "CB": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Small_Pads",
        "notes": "Cornerbacks quickly adopted small pads for coverage ability"
      },
      "S": {
        "pre2000": "Large_Pads",
        "2000s": "Medium_Pads",
        "2010s": "Small_Pads",
        "notes": "Safeties similar to CBs, prioritize range of motion"
      },
      "K": {
        "all": "Small_Pads",
        "notes": "Kickers always wore minimal pads"
      },
      "P": {
        "all": "Small_Pads",
        "notes": "Punters always wore minimal pads"
      }
    }
  },

  "armSleeves": {
    "description": "Evolution of arm sleeves from elbow pads to compression sleeves to shooter sleeves",
    "history": {
      "AllenIversonOrigin": {
        "date": "January 21, 2001",
        "notes": "Allen Iverson wore compression sleeve to support injured elbow. Started massive trend across basketball then football."
      },
      "NFLAdoption": {
        "startYear": 2005,
        "wideAdoption": 2008,
        "notes": "NFL players began adopting compression sleeves mid-2000s. By 2008-2010, sleeves were common across skill positions."
      }
    },
    "evolution": {
      "1970-1989": {
        "primaryStyle": "Elbow_Pads_None",
        "alternativeStyle": "Elbow_Pads_Only",
        "notes": "Traditional hard elbow pads or nothing. No compression sleeves existed. Linemen commonly wore elbow pads for protection."
      },
      "1990-1999": {
        "primaryStyle": "Elbow_Pads_None",
        "alternativeStyle": "Elbow_Pads_Only",
        "notes": "Still hard elbow pads era. Some players started wrapping elbows with tape."
      },
      "2000-2004": {
        "primaryStyle": "Elbow_Pads_None",
        "alternativeStyle": "Elbow_Pads_Only",
        "notes": "Transition era. Iverson's sleeve in 2001 starts influencing culture but hasn't hit NFL mainstream yet."
      },
      "2005-2009": {
        "primaryStyle": "Sleeve_Compression",
        "alternativeStyle": "Elbow_Pads_Only",
        "notes": "Compression sleeves enter NFL. Skill position players adopt quickly. Both full arm and elbow-only sleeves available."
      },
      "2010-2015": {
        "primaryStyle": "Sleeve_Compression",
        "alternativeStyle": "Sleeve_ShooterStyle",
        "notes": "Compression sleeves become mainstream. Shooter style (full arm, tight fit) emerges. Multiple colors available."
      },
      "2016-2025": {
        "primaryStyle": "Sleeve_ShooterStyle",
        "alternativeStyle": "Sleeve_Compression",
        "notes": "Modern shooter sleeves dominant. Both single arm and double arm common. Padded shooter sleeves for protection."
      }
    },
    "positionTendencies": {
      "QB": {
        "likelihood": "medium",
        "preferredArm": "non-throwing",
        "notes": "QBs sometimes wear on non-throwing arm. Cam Newton popularized the look."
      },
      "RB": {
        "likelihood": "high",
        "preferredArm": "both",
        "notes": "Running backs commonly wear for arm protection and aesthetics"
      },
      "WR": {
        "likelihood": "very_high",
        "preferredArm": "both",
        "notes": "Wide receivers most likely to wear sleeves - both for looks and minor protection"
      },
      "TE": {
        "likelihood": "medium",
        "preferredArm": "both",
        "notes": "Tight ends moderate usage"
      },
      "OL": {
        "likelihood": "low",
        "notes": "Offensive linemen rarely wear sleeves, prefer traditional elbow pads if anything"
      },
      "DL": {
        "likelihood": "low",
        "notes": "Defensive linemen similar to OL, less interested in sleeves"
      },
      "LB": {
        "likelihood": "medium",
        "preferredArm": "both",
        "notes": "Linebackers moderate usage, some pass rushers adopted them"
      },
      "CB": {
        "likelihood": "high",
        "preferredArm": "both",
        "notes": "Cornerbacks commonly wear sleeves"
      },
      "S": {
        "likelihood": "high",
        "preferredArm": "both",
        "notes": "Safeties similar to CBs"
      },
      "K": {
        "likelihood": "none",
        "notes": "Kickers don't wear arm sleeves"
      },
      "P": {
        "likelihood": "none",
        "notes": "Punters don't wear arm sleeves"
      }
    },
    "sleeveTypes": {
      "Elbow_Pads_Only": {
        "description": "Traditional hard plastic elbow pads, not fabric sleeves",
        "eraPopularity": "1970-2005"
      },
      "Sleeve_Compression": {
        "description": "Basic compression sleeve, typically elbow to wrist",
        "eraPopularity": "2005-present"
      },
      "Sleeve_ShooterStyle": {
