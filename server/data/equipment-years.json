  "tapeTrends": {
    "description": "Historical tape usage patterns - heavy taping was common in earlier eras",
    "overview": {
      "notes": "1970s-1990s was the 'heavy tape era'. Athletic trainers would tape ankles, wrists, fingers, and even cleats (spats) before every game. Modern ankle braces and better equipment reduced tape usage significantly."
    },
    "evolution": {
      "1970-1979": {
        "wristTape": "very_common",
        "fingerTape": "very_common",
        "spats": "very_common",
        "notes": "Peak taping era. Lenny Moore, Walter Payton, and others known for spats. Trainers taped everything - ankles, wrists, fingers. White tape was standard."
      },
      "1980-1989": {
        "wristTape": "very_common",
        "fingerTape": "common",
        "spats": "common",
        "notes": "Still heavy taping era. Spats started declining but still visible on many players. Wrist tape remained standard."
      },
      "1990-1999": {
        "wristTape": "common",
        "fingerTape": "common",
        "spats": "uncommon",
        "notes": "Transition era. Better ankle braces reduced need for spats. Finger and wrist tape still popular. Black tape became available."
      },
      "2000-2009": {
        "wristTape": "moderate",
        "fingerTape": "moderate",
        "spats": "rare",
        "notes": "Modern braces replaced much taping. Some traditionalists still tape. Wrist tape used more for injury prevention."
      },
      "2010-2019": {
        "wristTape": "uncommon",
        "fingerTape": "moderate",
        "spats": "very_rare",
        "notes": "Tape mostly replaced by modern equipment. Finger tape still used by some linemen and receivers. Spats essentially gone."
      },
      "2020-2025": {
        "wristTape": "rare",
        "fingerTape": "moderate",
        "spats": "vintage_only",
        "notes": "Tape usage minimal. Finger tape for grip still common among certain positions. Wrist tape only for injury management."
      }
    },
    "positionTendencies": {
      "QB": {
        "fingerTape": "rare",
        "wristTape": "rare",
        "spats": "never",
        "notes": "QBs avoid anything that affects ball grip or release. May tape injured finger."
      },
      "RB": {
        "fingerTape": "moderate",
        "wristTape": "common_pre2000",
        "spats": "common_pre1990",
        "notes": "Running backs historically taped heavily. Walter Payton famous for spats. Modern RBs tape less."
      },
      "WR": {
        "fingerTape": "moderate",
        "wristTape": "moderate",
        "spats": "rare",
        "notes": "Receivers may tape fingers for catching. Some used wrist tape. Moved to gloves over tape."
      },
      "TE": {
        "fingerTape": "moderate",
        "wristTape": "moderate",
        "spats": "common_pre1990",
        "notes": "Tight ends similar to receivers/linemen mix"
      },
      "OL": {
        "fingerTape": "very_common",
        "wristTape": "common",
        "spats": "common_pre2000",
        "notes": "Offensive linemen among heaviest tape users historically. Finger tape for grip still used today."
      },
      "DL": {
        "fingerTape": "very_common",
        "wristTape": "common",
        "spats": "common_pre2000",
        "notes": "Defensive linemen similar to OL. Heavy hand/wrist taping common through 1990s."
      },
      "LB": {
        "fingerTape": "moderate",
        "wristTape": "common_pre2000",
        "spats": "moderate_pre1990",
        "notes": "Linebackers moderate tape users"
      },
      "CB": {
        "fingerTape": "rare",
        "wristTape": "moderate",
        "spats": "moderate_pre1990",
        "notes": "Cornerbacks lighter tape users, prioritize mobility"
      },
      "S": {
        "fingerTape": "rare",
        "wristTape": "moderate",
        "spats": "moderate_pre1990",
        "notes": "Safeties similar to corners"
      },
      "K": {
        "fingerTape": "never",
        "wristTape": "never",
        "spats": "never",
        "notes": "Kickers don't tape"
      },
      "P": {
        "fingerTape": "never",
        "wristTape": "never",
        "spats": "never",
        "notes": "Punters don't tape"
      }
    },
    "tapeTypes": {
