{
  "name": "madden-draft-class-generator",
  "productName": "Madden Draft Class Generator",
  "version": "1.0.2",
  "description": "Generate importable Madden 26/27 draft classes from real NFL draft history",
  "main": "main.cjs",
  "author": "amatthews",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:m26 && npm run dist:m27",
    "dist:m26": "electron-builder --win --config builder-m26.json",
    "dist:m27": "electron-builder --win --config builder-m27.json",
    "postinstall": "electron-builder install-app-deps",
    "publish:m26": "electron-builder --win --config builder-m26.json --publish never",
    "publish:m27": "electron-builder --win --config builder-m27.json --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fzstd": "^0.1.1",
    "madden-franchise": "^4.3.6",
    "papaparse": "^5.5.3",
    "sharp": "^0.34.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  },
  "$comment": "The per-game electron-builder configs live in builder-m26.json / builder-m27.json (dist:m26 / dist:m27)."
}
